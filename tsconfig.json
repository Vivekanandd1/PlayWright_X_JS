{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "lib": ["ES2020", "DOM"]
  },
  "include": ["**/*.ts", "cuccumber.js"],
  "exclude": ["node_modules", "dist"]
}
